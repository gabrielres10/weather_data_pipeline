# Environment file for Docker Compose
# Copy this file to .env and set your API key

OPENWEATHERMAP_API_KEY=your_api_key_here

# ===== AIRFLOW CONFIGURATION =====
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
AIRFLOW_IMAGE_NAME=apache/airflow:3.0.0

# Admin user for Airflow UI
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# ===== PIPELINE CONFIGURATION =====
LOG_LEVEL=INFO

# PostgreSQL connection for weather data (automatically configured for Docker)
POSTGRES_CONNECTION=postgresql://airflow:airflow@postgres:5432/weatherdb